-        SERVER_STRING = f'ssl:{args.port}:privateKey={cert_skpath}:certKey={cert_pempath}:dhParameters={dhparam_path}:interface={args.host}'
+        # Twisted endpoint descriptions use ":" as a separator and "\" as an
+        # escape character.  Interpolating a raw filesystem path breaks on
+        # Windows: backslashes get consumed as escapes and the drive letter's
+        # ":" terminates the value early.  Escape both instead of assuming
+        # POSIX-style paths.
+        def _endpoint_path(p):
+            return str(p).replace('\\', '\\\\').replace(':', '\\:')
+
+        SERVER_STRING = (f'ssl:{args.port}'
+                         f':privateKey={_endpoint_path(cert_skpath)}'
+                         f':certKey={_endpoint_path(cert_pempath)}'
+                         f':dhParameters={_endpoint_path(dhparam_path)}'
+                         f':interface={args.host}')
         print(SERVER_STRING)
 
         hs.app.run(host=HOSTNAME, port=args.port, endpoint_description=SERVER_STRING)
